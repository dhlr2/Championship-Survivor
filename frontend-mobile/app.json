{
  "expo": {
    "name": "Championship Survivor",
    "slug": "championship-survivor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#080C10",
    "splash": {
      "backgroundColor": "#080C10",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yourname.lastmanstanding"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080C10"
      },
      "package": "com.yourname.lastmanstanding"
    },
    "scheme": "lastmanstanding",
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ]
  }
}